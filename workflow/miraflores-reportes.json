        "webhookId": "5d0a7f6e-3b1c-4c52-9a43-0c9f4f1e7a10",
        "id": "558e90ad-6bdc-4ac1-ac52-42a1196969dc"
      },
      {
        "parameters": {
          "jsCode": "const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n// The webhook delivers the raw body so a malformed JSON returns 400 DATOS_INVALIDOS\n// instead of n8n's own 422 parsing error.\nlet parsed = {};\nconst item = $input.first();\nif (item.binary && item.binary.data) {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  try {\n    parsed = JSON.parse(buf.toString('utf8'));\n  } catch (e) {\n    return [{ json: { decision: 'INVALIDO', request_id: null,\n      errores: ['El cuerpo de la solicitud debe ser un JSON válido'], data: {} } }];\n  }\n}\nconst b = (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) ? parsed : {};\nconst str = (v) => (typeof v === 'string' ? v.trim() : null);\nconst up = (v) => (str(v) === null ? null : str(v).toUpperCase());\nconst errores = [];\n\nconst requestId = str(b.request_id);\nconst requestIdValido = requestId !== null && UUID_RE.test(requestId);\nif (!requestIdValido) errores.push('request_id debe ser un UUID válido');\n\nconst distrito = up(b.distrito);\nif (!['MIRAFLORES', 'SURQUILLO', 'OTRO'].includes(distrito)) {\n  errores.push('distrito debe ser MIRAFLORES, SURQUILLO u OTRO');\n}\n\nconst categoria = up(b.categoria);\nconst categoriaValida = ['ACUMULACION', 'OMISION_RECOJO', 'VOLUMINOSO'].includes(categoria);\nif (!categoriaValida) errores.push('categoria debe ser ACUMULACION, OMISION_RECOJO o VOLUMINOSO');\n\nconst referencia = str(b.referencia);\nif (referencia === null || referencia.length < 5 || referencia.length > 120) {\n  errores.push('referencia debe tener entre 5 y 120 caracteres');\n}\nconst descripcion = str(b.descripcion);\nif (descripcion === null || descripcion.length < 15 || descripcion.length > 200) {\n  errores.push('descripcion debe tener entre 15 y 200 caracteres');\n}\nif (typeof b.obstruccion !== 'boolean') errores.push('obstruccion debe ser verdadero o falso');\n\nconst sector = up(b.sector);\nif (distrito === 'MIRAFLORES' && !sector) errores.push('sector es obligatorio para MIRAFLORES');\n\nif (categoria === 'ACUMULACION') {\n  if (!Number.isInteger(b.bolsas) || b.bolsas < 1 || b.bolsas > 50) {\n    errores.push('bolsas debe ser un entero entre 1 y 50 para ACUMULACION');\n  }\n} else if (categoriaValida && b.bolsas !== undefined && b.bolsas !== null) {\n  errores.push('bolsas solo aplica a ACUMULACION');\n}\n\nlet decision = 'ADMITIDO';\nif (errores.length > 0) decision = 'INVALIDO';\nelse if (distrito !== 'MIRAFLORES') decision = 'FUERA_JURISDICCION';\n\nreturn [{ json: {\n  decision,\n  request_id: requestIdValido ? requestId.toLowerCase() : null,\n  errores,\n  data: {\n    sector,\n    categoria,\n    referencia,\n    descripcion,\n    obstruccion: b.obstruccion,\n    bolsas: categoria === 'ACUMULACION' ? b.bolsas : null,\n  },\n} }];"
        },
