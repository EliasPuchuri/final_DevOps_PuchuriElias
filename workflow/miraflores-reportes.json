        "parameters": {
          "jsCode": "const j = $input.first().json;\n// Automated tests send \"X-Origen: prueba\" so they can be told apart from demo visitors.\nconst h = $('Webhook reportes').first().json.headers || {};\nconst origen = String(h['x-origen'] || '').toLowerCase() === 'prueba' ? 'prueba' : 'demo';\n$execution.customData.set('http_status', String(j.http_status));\n$execution.customData.set('resultado', j.resultado);\n$execution.customData.set('origen', origen);\nif (j.request_id) $execution.customData.set('request_id', j.request_id);\nif (j.reporte_id) $execution.customData.set('reporte_id', String(j.reporte_id));\nreturn [{ json: { ...j, origen } }];"
        },
