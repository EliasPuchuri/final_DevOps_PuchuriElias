      {
        "parameters": {
          "jsCode": "const j = $input.first().json;\nconst rid = $('Validar y normalizar').first().json.request_id;\nreturn [{ json: {\n  http_status: j.http_status,\n  resultado: j.resultado,\n  request_id: rid,\n  reporte_id: j.reporte_id,\n  body: {\n    codigo_publico: j.codigo_publico,\n    estado: j.estado,\n    prioridad: j.prioridad,\n    cola: j.cola,\n    plazo_horas: j.plazo_horas,\n    fecha_limite: j.fecha_limite_lima,\n    fecha_limite_iso: j.fecha_limite_iso,\n    duplicado: j.duplicado,\n    mensaje: j.duplicado ? 'Este reporte ya estaba registrado. Se devuelve el original.' : 'Reporte registrado correctamente.',\n  },\n} }];"
